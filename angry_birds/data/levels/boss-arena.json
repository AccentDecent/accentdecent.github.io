        50000,
        90000,
        140000
      ],
      "scripts": [
        {
          "hook": "onLevelStart",
          "name": "intro cutscene",
          "code": "ctx.cutscene([\n  { x: 1250, y: 400, zoom: 0.7, ms: 1600, hold: 500 },\n  { x: ctx.game.slingshot.x + 220, y: 380, zoom: 0.72, ms: 1200 }\n], () => {});\nctx.after(3600, () => ctx.message('Defeat the King Pig!', 2500));"
        },
        {
          "hook": "onBossPhaseChange",
          "name": "phase fx",
          "code": "ctx.shake(12, 500);\nctx.explode(ctx.event.track.body.position.x, ctx.event.track.body.position.y, 120, 0.12);\nctx.message('The King Pig grows ' + ctx.event.phase.name + '!', 2200);"
        }
      ],
      "intro": "The King Pig himself guards the eggs. Break his defenses, then bring him down through all THREE phases!",
      "outro": "The eggs are safe... for now. The pigs will surely return. 🥚",
      "nextLevel": null
    }
  ]
